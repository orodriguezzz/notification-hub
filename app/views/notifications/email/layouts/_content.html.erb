<h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;color:#1f2933;"><%= content.title %></h1>
<p style="margin:0 0 24px 0;font-size:16px;line-height:1.6;color:#3e4c59;"><%= content.body %></p>
<% if content.action? %>
  <table role="presentation" cellpadding="0" cellspacing="0">
    <tr>
      <td style="border-radius:6px;background:<%= accent %>;">
        <a href="<%= content.action_url %>" style="display:inline-block;padding:12px 24px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">
          <%= content.action_label %>
        </a>
      </td>
    </tr>
  </table>
<% end %>

<%= render layout: "notifications/email/layouts/frame", locals: { subject: subject, accent: "#0d9488" } do %>
  <h1 style="margin:0 0 8px 0;font-size:22px;line-height:1.3;color:#1f2933;"><%= subject %></h1>
  <p style="margin:0 0 24px 0;font-size:15px;color:#52606d;"><%= t("notifications.digest.intro") %></p>
  <% contents.each do |content| %>
    <div style="padding:16px 0;border-top:1px solid #e4e7eb;">
      <h2 style="margin:0 0 8px 0;font-size:17px;color:#1f2933;"><%= content.title %></h2>
      <p style="margin:0 0 8px 0;font-size:15px;line-height:1.5;color:#3e4c59;"><%= content.body %></p>
      <% if content.action? %>
        <a href="<%= content.action_url %>" style="font-size:14px;font-weight:bold;color:#0d9488;"><%= content.action_label %></a>
      <% end %>
    </div>
  <% end %>
<% end %>
